{
  "name": "@grosz/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/index.ts",
    "start": "node src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../.env src/migrate.ts",
    "db:seed": "node --env-file-if-exists=../.env src/seed.ts",
    "db:bootstrap": "node --env-file-if-exists=../.env src/bootstrap.ts"
  },
  "dependencies": {
    "@grosz/shared": "*",
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/static": "^10.1.5",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
