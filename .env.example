# Skopiuj do .env (tylko na NAS; .env nie trafia do gita).
# Lokalnie .env nie jest potrzebny — bez DATABASE_URL aplikacja używa bazy PGlite w .data/.

# Postgres w kontenerze stosu Anvero; łączymy się po nazwie kontenera przez wspólną sieć Dockera.
DATABASE_URL=postgres://grosz:ZMIEN_HASLO@anvero-db-db-1:5432/grosz

# Sieć Dockera, w której działa kontener Postgresa (docker inspect <kontener> → NetworkSettings.Networks).
PG_NETWORK=anvero-db_default

# Obraz do kopii zapasowych — ta sama lub nowsza wersja niż serwer Postgres.
PG_IMAGE=postgres:17-alpine
