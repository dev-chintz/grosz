# Skopiuj do .env (tylko na NAS; .env nie trafia do gita).
# Lokalnie .env nie jest potrzebny — bez DATABASE_URL aplikacja używa bazy PGlite w .data/.

# Postgres w osobnym kontenerze, port 5432 wystawiony na NAS.
DATABASE_URL=postgres://grosz:ZMIEN_HASLO@host.docker.internal:5432/grosz

# Obraz do kopii zapasowych — ta sama lub nowsza wersja niż serwer Postgres.
PG_IMAGE=postgres:17-alpine
